---
import { Icon, Shell } from '@app';
import { business } from '../features/home/content';
import styles from './styles.module.css';
---
<Shell name={business.name} description={business.description} noindex>
  <main class={styles.notFound}>
    <p class={styles.eyebrow}>Page not found</p>
    <h1 class={styles.heading}>This page didn't <em>grow here.</em></h1>
    <p class={styles.copy}>The link may be old or mistyped. Everything lives on the home page.</p>
    <a class={styles.home} href={import.meta.env.BASE_URL}>Back to ShadeTree.IT <Icon name="arrow-right" /></a>
  </main>
</Shell>
