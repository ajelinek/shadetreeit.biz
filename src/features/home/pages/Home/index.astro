---
import { Image } from 'astro:assets';
import Shell from '../../../../app/Shell.astro';
import portrait from '../../../../assets/adam.jpg';
import { business, services } from '../../content';
import styles from './styles.module.css';
---
<Shell>
  <a class={styles.skip} href="#main">Skip to content</a>
  <header class={styles.header}>
    <a class={styles.brand} href="#top"><img src="/tree.png" alt="" width="42" height="42" /><span>{business.name}</span></a>
    <nav class={styles.nav} aria-label="Main navigation">
      <a href="#services">Services</a><a href="#about">About</a><a href="#contact">Contact</a>
    </nav>
  </header>
  <main id="main">
    <section class={styles.hero} id="top" aria-labelledby="hero-title">
      <div class={styles.heroContent}>
        <p class={styles.eyebrow}><span></span> A little more possible</p>
        <h1 id="hero-title">Less busywork.<br />Better decisions.<br /><em>More room to grow.</em></h1>
        <p class={styles.heroCopy}>Practical technology and thoughtful guidance for small businesses, whether you're just getting started or ready for what's next.</p>
        <a class={styles.primaryLink} href="#contact">Let's talk about your business <span aria-hidden="true">↗</span></a>
      </div>
      <div class={styles.heroArt} aria-hidden="true"><div class={styles.orbit}><img src="/tree.png" alt="" width="407" height="407" /></div><p>GOOD IDEAS<br />GROW HERE <span>✳</span></p></div>
      <p class={styles.heroFoot}>TECHNOLOGY <span> / </span> PEOPLE <span> / </span> POSSIBILITY</p>
    </section>
    <section class={styles.services} id="services" aria-labelledby="services-title">
      <div class={styles.sectionIntro}><p class={styles.eyebrow}>01 / HOW I CAN HELP</p><div><h2 id="services-title">Good work starts with <em>the right tools.</em></h2><p>Technology should make your business easier to run—not give you one more thing to manage. Let's find a practical way forward, together.</p></div></div>
      <div class={styles.serviceList}>
        {services.map((service) => <article class={styles.service}><span class={styles.serviceNumber}>{service.number}</span><h3>{service.title}</h3><p>{service.description}</p><span class={styles.serviceArrow} aria-hidden="true">↗</span></article>)}
      </div>
      <p class={styles.additional}>And if your online presence needs attention, I can help with <strong>websites, your digital footprint, and basic SEO</strong>, too.</p>
    </section>
    <section class={styles.about} id="about" aria-labelledby="about-title">
      <div class={styles.portraitWrap}><Image src={portrait} alt="Adam Jelinek, owner of ShadeTree.IT LLC" width={700} height={700} class={styles.portrait} /><span class={styles.portraitCaption}>THE PERSON BEHIND THE WORK <span>↗</span></span></div>
      <div class={styles.aboutCopy}><p class={styles.eyebrow}>02 / A PERSONAL APPROACH</p><h2 id="about-title">Technology is better when it <em>works for people.</em></h2><p>I'm Adam. My background spans software engineering, technology leadership, process improvement, and data. I've seen how the right tools and a clear plan can help people do their best work.</p><p>I bring that experience to small businesses with a straightforward, personal approach: listen first, understand what matters, and build from there.</p><p class={styles.signature}>Adam Jelinek <span>— Owner, ShadeTree.IT LLC</span></p></div>
    </section>
    <section class={styles.contact} id="contact" aria-labelledby="contact-title"><div><p class={styles.eyebrow}>03 / LET'S CONNECT</p><h2 id="contact-title">What's on your <em>mind?</em></h2><p>Have an idea, a challenge, or just a question? I'd love to hear about your business and what you're working toward.</p></div><div class={styles.contactLinks}><a href={`mailto:${business.email}`}>{business.email}<span aria-hidden="true">↗</span></a><a href={business.phoneHref}>{business.phone}<span aria-hidden="true">↗</span></a><p>Reach out in whatever way feels right.</p></div></section>
  </main>
  <footer class={styles.footer}><p>© {new Date().getFullYear()} {business.name}</p><nav aria-label="Social links"><a href={business.linkedIn}>LinkedIn ↗</a><a href={business.medium}>Writing on Medium ↗</a></nav><a href="#top">Back to top ↑</a></footer>
</Shell>
